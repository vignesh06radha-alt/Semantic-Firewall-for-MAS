# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Per-Agent Gemini API Key Allocations (distributes rate limits across independent quotas)
GEMINI_API_KEY_ATLAS="your_atlas_key_here"
GEMINI_API_KEY_BOHR="your_bohr_key_here"
GEMINI_API_KEY_CURIE="your_curie_key_here"
GEMINI_API_KEY_FARADAY="your_faraday_key_here"
GEMINI_API_KEY_GAUSS="your_gauss_key_here"
GEMINI_API_KEY_DENG="your_deng_key_here"
GEMINI_API_KEY_EDISON="your_edison_key_here"
GEMINI_API_KEY_FIREWALL="your_firewall_key_here"

# Engine Parameters
CLASSIFIER_BACKEND_URL="http://127.0.0.1:8000/v1/chat/completions"
FIREWALL_TIMEOUT_MS=1500
MAX_ALLOWED_HOPS=6
FAIL_CLOSED=True
