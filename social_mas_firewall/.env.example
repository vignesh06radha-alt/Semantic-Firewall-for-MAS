# Copy to .env. Everything defaults sensibly for a local Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_MODEL=llama3.2:3b
# Guardian LLM. Same weights as the agents by default only because a 6GB GPU
# can't hold two models at once; use a different model when VRAM allows.
GUARD_MODEL=llama3.2:3b
# Optional independent Ollama judge endpoint; empty shares OLLAMA_BASE_URL.
GUARD_BASE_URL=
GUARD_BACKEND=ollama_json
# Native guard (vLLM, or a completion-compatible Colab service)
LLAMA_GUARD_BASE_URL=http://127.0.0.1:8000/v1
LLAMA_GUARD_MODEL=meta-llama/Llama-Guard-3-8B
LLAMA_GUARD_API_KEY=
LLAMA_GUARD_OLLAMA_MODEL=llama-guard3:8b
# Optional per-request context size; 0 leaves the Ollama default unchanged.
OLLAMA_NUM_CTX=0
OLLAMA_KEEP_ALIVE=30m
# A2A service; set an API key when exposing beyond local use.
A2A_HOST=127.0.0.1
A2A_PORT=9000
A2A_PUBLIC_URL=http://127.0.0.1:9000/
A2A_API_KEY=
# true = offline heuristic stand-ins (wiring tests only, never for numbers)
MOCK_LLM=false
# Legacy scheduling option; both schedules enforce pre-delivery screening.
PARALLEL_GUARD=true
# any of: detector,judge,watch,egress
GUARD_LAYERS=detector,judge,watch,egress
