# Copy this file to `.env`. Never commit `.env`.

OLLAMA_BASE_URL=http://127.0.0.1:11434
GUARD_MODEL=llama-guard3:8b
# gemma4:26b measured ~275s/call here -- impractical across a 200-item x
# 3-config sweep. llama3.2:3b (~10s/call) is what makes a real run practical;
# swap back if you have the GPU budget for a larger model.
AGENT_MODEL=llama3.2:3b

FIREWALL_TIMEOUT_MS=8000
AGENT_TIMEOUT_MS=120000
MAX_ITERATIONS=4

# Fast offline heuristics standing in for real Ollama calls -- see README's
# "Mock vs real" section. Independent toggles: you can mock the agents while
# hitting the real guard model, or vice versa.
MOCK_AGENTS=false
MOCK_FIREWALL=false
